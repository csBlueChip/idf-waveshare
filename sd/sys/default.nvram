# default.nvram - every NV setting at its default value
# NV IMPORT default   restores them (sys.bootcnt is firmware-owned, not here)
# Format: key=value, one per line; '#' starts a comment;
# !key=value is a secret: FCAT default.nvram shows !key=[redacted].

wifi.ssid=wavedemo
!wifi.pwd=waveP@55word
wifi.ip=192.168.4.1
wifi.cidr=/24
wifi.pwr=8.5
wifi.gw=1
wifi.maxconn=1
ble.name=ESP32-S3-Demo
ble.pwr=9
sys.ui=BLE
ser.baud=115200
ser.echo=1
web.name=
web.port=80
web.captive=1
telnet.port=23
scr.bl=100
scr.pflip=0
scr.lflip=0
btn.deb=30
btn.long=600
btn.dbl=300
btn.rpt=0
btn.touch=0.015
web.hist=50
disk.read=0 255 0
disk.write=255 0 0
imu.arange=4
imu.arate=224
imu.grange=512
imu.grate=224
imu.wom=100
imu.tap.thr=1.3
imu.tap.gap=500
imu.mot.thr=100
imu.still.thr=64
imu.step.thr=200
imu.step.min=10
imu.orient.hold=500
imu.orient.flat=30
run.files=4
sys.autorun=0
sys.aron=0 255 0
sys.aroff=255 0 0
