# default.nvram - every NV setting at its default value
# NV IMPORT default   restores them (sys.bootcnt is firmware-owned, not here)
# Format: key=value, one per line; '#' starts a comment;
# !key=value is a secret: FCAT default.nvram shows !key=[redacted].

ble.ansi.ui=0
ble.name=*
ble.pwr=9
btn.dbl=300
btn.deb=30
btn.gpio=0 2 4 5 6 7 8 9 10 11
btn.long=600
btn.rpt=0
btn.touch=0.015
disk.read=0,255,0
disk.write=255,0,0
imu.arange=4
imu.arate=224
imu.gcal=
imu.grange=512
imu.grate=224
imu.mot.thr=100
imu.orient.flat=30
imu.orient.hold=500
imu.step.min=10
imu.step.thr=200
imu.still.thr=64
imu.tap.gap=500
imu.tap.thr=1.3
imu.wom=100
run.files=4
scr.bl=20
scr.bl.steps=20
ser.echo=1
sys.aroff=255,0,0
sys.aron=0,255,0
sys.autorun=0
sys.ui=BLE
telnet.ansi.ui=1
telnet.port=23
uart.ansi.con=1
uart.ansi.ui=1
uart.baud=115200
uart.rx=44
uart.tx=43
usb.ansi.con=1
usb.ansi.ui=1
web.ansi.ui=1
web.captive=1
web.hist=50
web.name=
web.port=80
wifi.cidr=/24
wifi.gw=1
wifi.ip=192.168.4.1
wifi.maxconn=1
!wifi.pwd=*
wifi.pwr=8.5
wifi.ssid=*
