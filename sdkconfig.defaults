# Target chip (so a fresh sdkconfig never falls back to plain esp32)
CONFIG_IDF_TARGET="esp32s3"

# BLE: NimBLE host only
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# Main task runs command handlers (PNG decode)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FAT long file names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# USB disk mode (TinyUSB mass storage)
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="WaveDemo SD"
CONFIG_TINYUSB_DESC_MSC_STRING="WaveDemo SD"

# Flash: 16 MB, custom OTA partition table (partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Save crash dumps to the coredump partition (idf.py coredump-info)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# PSRAM: 8 MB octal (ESP32-S3R8) - holds the two LCD frame buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Web console: WebSocket support in the HTTP server
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# FreeRTOS tick 200 Hz (5 ms): finer delays/button timing than the 100 Hz default
CONFIG_FREERTOS_HZ=200

# RAM: keep internal RAM for what needs it (code, DMA, interrupts)
#  - marked statics (EXT_RAM_BSS_ATTR) live in PSRAM
#  - Wi-Fi / lwIP and NimBLE buffers in PSRAM
#  - malloc() of more than 4 KB goes to PSRAM first
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# MEM command: task list with stack high-water marks
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
